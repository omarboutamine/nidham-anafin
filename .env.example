# Copy values into Netlify → Site settings → Environment variables
# Do NOT commit real passwords.
#
# Recommended (best deliverability to @univ-*.dz):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=omar.boutamine@univ-constantine2.dz
SMTP_PASS=YOUR_EMAIL_PASSWORD_OR_APP_PASSWORD
MAIL_FROM=Nidham Anafin <omar.boutamine@univ-constantine2.dz>
#
# If SMTP is not set, the function falls back to FormSubmit.
# Each new recipient email must activate FormSubmit once (link in inbox/spam),
# then click «Resend code».
#
# Optional local override with `netlify dev`:
# VITE_OTP_API_URL=http://localhost:8888/.netlify/functions/send-otp
